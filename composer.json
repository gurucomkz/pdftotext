{
    "name": "pmdunggh/pdftotext",
    "version": "1.6.7",
    "type": "library",
    "description": "Extract text, image from PDF file",
    "keywords": ["pdf2text","pdftotext"],
    "homepage": "http://www.pdftotext.eu",
    "license": "GNU v3.0",
    "authors": [
        {
            "name": "Christian Vigh",
            "email": "christian.vigh@wuthering-bytes.com"
        },
        {
            "name": "Pham Minh Dung",
            "email": "pmdung@gmail.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "VanXuan\\PdfToText\\": "src"
        }
    },
    "scripts": {
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "XDEBUG_MODE=coverage ./vendor/bin/phpunit"
        ],
        "stan": [
            "Composer\\Config::disableProcessTimeout",
            "./vendor/bin/phpstan analyze --memory-limit=1G"
        ]
    },
    "require-dev": {
        "phpstan/phpstan": "2.1.x-dev",
        "squizlabs/php_codesniffer": "4.x-dev",
        "phpunit/phpunit": "^12.4@dev"
    },
    "minimum-stability": "dev"
}
